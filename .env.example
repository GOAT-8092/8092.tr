# Environment Variables Example
# Copy this file to .env and set your local values

# Portal authentication password
# PUBLIC_ prefix makes it available in client-side code (required for Astro)
PUBLIC_PORTAL_PASS=your_portal_password_here

# OpenAI API Configuration
# Server-side only - NOT exposed to client
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Assistants Configuration (can be PUBLIC as they are not sensitive)
PUBLIC_OPENAI_ASSISTANT_ID=asst_v1gZYfAo9yWmfOVetaZkMf1n
PUBLIC_OPENAI_VECTOR_STORE_ID=vs_6962cee9a42881919a97a703d11920be
